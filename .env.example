# ─── Database (MariaDB via docker-compose) ───────────────────────────────
DB_HOST=localhost
# 3311 to avoid clashing with other local MySQL/MariaDB instances on 3306
DB_PORT=3311
DB_NAME=duet
DB_USER=duet
DB_PASSWORD=duetpass
DB_ROOT_PASSWORD=rootpass
# Full connection string used by Drizzle + Better Auth
DATABASE_URL=mysql://duet:duetpass@localhost:3311/duet

# ─── Better Auth ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-dev-secret-change-me-dev-secret=
BETTER_AUTH_URL=http://localhost:5180
# Encrypts project secrets at rest. Falls back to BETTER_AUTH_SECRET if blank.
# Set it in production and never change it — existing secrets can't be decrypted
# with a different key. Generate with: openssl rand -base64 32
SECRETS_KEY=
# Public base URL available to the browser client
PUBLIC_BETTER_AUTH_URL=http://localhost:5180

# ─── GitHub OAuth (https://github.com/settings/developers) ───────────────
# Authorization callback URL: http://localhost:5180/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────
# Delivery order: RESEND_API_KEY (prod) → SMTP (dev/Mailpit) → console fallback.
#
# Dev — Mailpit (bundled in docker-compose). View captured mail at :8026.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Duet <no-reply@duet.local>
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# Prod — Resend (https://resend.com). Set a verified sender in EMAIL_FROM,
# e.g. "Duet <login@yourdomain.com>". Takes precedence over SMTP when set.
RESEND_API_KEY=

# ─── Image storage (Cloudflare R2) ───────────────────────────────────────
# Create an R2 bucket + API token (Object Read & Write). Account ID is in the
# R2 dashboard URL. Leave blank in dev to store uploads on local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=duet
UPLOAD_MAX_MB=10
