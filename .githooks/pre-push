#!/usr/bin/env bash
# Prompts to bump package.json version when pushing to main, commits the bump,
# then re-pushes (git already fixed the objects for this push before the hook
# ran, so a commit made here won't ride along with it otherwise).
set -e

if [ -n "$DUET_SKIP_VERSION_BUMP_HOOK" ]; then
	exit 0
fi

remote="$1"

pushing_main=false
main_local_ref=""
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
		pushing_main=true
		main_local_ref=$local_ref
	fi
done

if [ "$pushing_main" != true ]; then
	exit 0
fi

if [ ! -t 1 ] || [ ! -e /dev/tty ]; then
	exit 0
fi

current_version=$(node -p "require('./package.json').version")
echo "Pushing to main (current version: $current_version)." > /dev/tty
echo "Bump version? [p]atch / [m]inor / [M]ajor / [n]one (default: n): " > /dev/tty
read -r choice < /dev/tty

case "$choice" in
	p|P) bump=patch ;;
	m) bump=minor ;;
	M) bump=major ;;
	*) exit 0 ;;
esac

npm version "$bump" --no-git-tag-version > /dev/null
new_version=$(node -p "require('./package.json').version")

git add package.json package-lock.json 2>/dev/null || git add package.json
git commit -m "Bump version to $new_version" --quiet

echo "Bumped version to $new_version. Re-pushing with the bump included..." > /dev/tty

DUET_SKIP_VERSION_BUMP_HOOK=1 git push "$remote" "$main_local_ref:refs/heads/main"

# The re-push above already sent everything; stop this original push from
# also running (it would fail as a no-op/stale-ref anyway).
exit 1
